# Copy to .env and fill in — .env is gitignored, never commit real values.

# Database
DATABASE_URL=postgresql://bilingual:bilingual@localhost:5434/bilingual_search
DB_POOL_MAX=10

# LLM providers (R22) — fill in whichever you plan to use
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Embedding providers (R23) — Gemini uses GEMINI_API_KEY above; Jina needs its own
JINA_API_KEY=

# 9Router — local AI router with 3-tier fallback (https://9router.com)
# Install: npm install -g 9router && 9router
# Copy API key from http://localhost:20128/dashboard
NINE_ROUTER_API_KEY=
NINE_ROUTER_URL=http://localhost:20128
NINE_ROUTER_LLM_MODEL=oc/mimo-v2.5-free
NINE_ROUTER_EMBED_MODEL=text-embedding-3-small

# Cerebras — fastest free-tier inference (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b

# SambaNova Cloud — free-tier fast inference (https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Generic OpenAI-compatible — works with Ollama, LM Studio, vLLM, etc.
CUSTOM_OPENAI_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=default

# Admin UI auth (R26) — default admin credentials (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# JWT secret for admin session tokens
JWT_SECRET=change-me-to-a-random-string
